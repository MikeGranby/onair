{
  // Govee Developer API key (Govee Home app: Profile > Settings > Apply for API Key).
  // If left blank, the GOVEE_API_KEY environment variable is used instead.
  "GoveeApiKey": "PUT API KEY HERE",

  // Outlets to switch on while the microphone or camera is in use. Identify each one either by
  // its name exactly as shown in the Govee Home app, or by "Sku" and "Device" (run
  // "OnAir --list-devices" to see them). For multi-socket plugs, add "Instance":
  // "socketToggle1", "socketToggle2", etc.; the default is "powerSwitch".
  //
  // The level is Audio (1) while only the microphone is in use, and Video (2) while the camera
  // is. "Level" picks when an outlet comes on:
  //   left out = at either level
  //   1        = only at Audio (goes off when the camera comes on)
  //   2        = only at Video
  // e.g. { "Name": "Camera Light", "Level": 2 }
  "Outlets": [
    { "Name": "On Air 1" }
  ],

  // How long the microphone or camera must stay in use before outlets turn on.
  "OnDelaySeconds": 1,

  // How long the microphone or camera must stay idle before outlets turn off.
  "OffDelaySeconds": 5,

  // Fallback re-check interval. Changes are normally detected instantly via registry notifications.
  "PollIntervalSeconds": 5,

  // Apps to ignore, matched as case-insensitive substrings of the app's path or package name
  // (run "OnAir --status" to see what is using the microphone and camera).
  "ExcludeApps": [],

  // Turn the outlets off when OnAir exits.
  "TurnOffOnExit": true
}
